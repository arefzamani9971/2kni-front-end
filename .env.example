# ---- Build-time (inlined into the browser bundles; rebuild images after changing) ----
# live = real backend through the BFF; mock = MSW mock backend in the browser (demo)
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_URL=https://api.2kni.ir
# Product release gate (1.0, 1.1, 1.2, 2.0, 2.1, 3.0, 3.1, 4.0) and independent flags
NEXT_PUBLIC_RELEASE=1.0
NEXT_PUBLIC_FLAGS=
NEXT_PUBLIC_SELLER_URL=https://app.2kni.ir
NEXT_PUBLIC_CUSTOMER_URL=https://my.2kni.ir
NEXT_PUBLIC_LANDING_URL=https://2kni.ir
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---- Runtime (server side only) ----
# API origin reachable from the seller/customer containers (BFF auth route handlers)
API_INTERNAL_URL=http://api:8080
# false only for plain-http local testing of the live mode
BFF_COOKIE_SECURE=true

# ---- Edge nginx ----
LANDING_DOMAIN=2kni.ir
SELLER_DOMAIN=app.2kni.ir
CUSTOMER_DOMAIN=my.2kni.ir
API_DOMAIN=api.2kni.ir
API_UPSTREAM=api:8080
CERTS_DIR=./deploy/certs
ACME_DIR=./deploy/acme
IMAGE_TAG=latest
