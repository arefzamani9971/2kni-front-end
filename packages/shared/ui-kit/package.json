{
  "name": "@dukani/ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./location": "./src/location/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "nx": {
    "tags": ["type:ui-kit", "scope:shared"]
  },
  "scripts": {
    "lint": "eslint src .storybook",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@dukani/design-tokens": "workspace:*",
    "@dukani/domain": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react-leaflet": "5.0.0",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3"
  }
}
