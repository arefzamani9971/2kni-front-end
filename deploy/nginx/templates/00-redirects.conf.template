# HTTP → HTTPS for every host (ACME challenge stays on HTTP).
server {
  listen 80 default_server;
  server_name _;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

# www → apex
server {
  listen 443 ssl;
  http2 on;
  server_name www.${LANDING_DOMAIN};
  ssl_certificate     /etc/letsencrypt/live/${LANDING_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${LANDING_DOMAIN}/privkey.pem;
  include /etc/nginx/snippets/tls.conf;
  return 301 https://${LANDING_DOMAIN}$request_uri;
}
