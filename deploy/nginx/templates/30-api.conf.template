# api.2kni.ir — the .NET backend (outside this repo). Remove this file if the API has its own edge.
# Resolved at request time (Docker DNS), so the edge starts even when the API container is elsewhere.
server {
  listen 443 ssl;
  http2 on;
  server_name ${API_DOMAIN};
  ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/security-headers.conf;
  resolver 127.0.0.11 valid=30s ipv6=off;

  location / {
    set $api_upstream http://${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
